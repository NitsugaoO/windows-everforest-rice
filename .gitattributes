# 默认按文本处理，仓库内统一 LF
* text=auto eol=lf

# Windows 侧工具生成的文本：保持 CRLF（regedit / wscript / 计划任务导入更稳）
*.ps1  text eol=crlf
*.reg  text eol=crlf
*.vbs  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.xml  text eol=crlf

# WSL 脚本必须是 LF —— CRLF 会让 shebang 变成 /bin/bash^M，报 bad interpreter
wsl/bin/*  text eol=lf
wsl/gdb/*  text eol=lf
wsl/tmux/* text eol=lf

# 二进制资源，不要做任何转换
*.png  binary
*.ico  binary
*.vsix binary
*.pak  binary
*.gif  binary
